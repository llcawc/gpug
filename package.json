{
  "name": "@pasmurno/gpug",
  "version": "0.0.1",
  "description": "Gulp plugin for compiling Pug templates",
  "keywords": [
    "compile",
    "gulp",
    "html",
    "jade",
    "pug",
    "templates"
  ],
  "homepage": "https://github.com/llcawc/gpug",
  "license": "MIT",
  "author": "llcawc",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "readme.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/gpug.cjs",
  "module": "./dist/gpug.js",
  "types": "./dist/gpug.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/gpug.d.ts",
        "require": "./dist/gpug.d.cts"
      },
      "import": "./dist/gpug.js",
      "require": "./dist/gpug.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "check": "oxfmt --check",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "validate": "oxlint && tsc --noEmit && vitest --run",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "plugin-error": "^2.0.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pug": "^2.0.10",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
